          "maxLength": 120
        },
        "encryptedMobile": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": [
            "DEPUTY",
            "EMPLOYER_MANAGER",
            "EMPLOYER_CEO",
            "EMPLOYER_EXPERT",
            "CONTRACTOR_CEO",
            "RESIDENT_REP",
            "GROUP_SUPERVISOR",
            "TECHNICIAN"
          ]
        },
        "organizationId": {
          "type": "string",
          "enum": ["org-1", "org-2"]
        },
        "companyId": {
          "type": "string",
          "maxLength": 64
        },
        "unitId": {
          "type": "string",
          "maxLength": 64
        },
        "groupIds": {
          "type": "array"
        },
        "isActive": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "loginCount": {
          "type": "number"
        },
        "lastLoginAt": {
          "type": "string",
          "maxLength": 64
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["_id", "fullName", "encryptedMobile", "role", "organizationId", "isActive", "loginCount", "ownerUid", "createdAt", "updatedAt"]
    },
