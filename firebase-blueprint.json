  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Administrator privilege markers."
    },
    "/orgMembers/{uid}": {
      "schema": { "$ref": "#/entities/OrgMember" },
      "description": "Authenticated organizational member records."
    },
    "/personnel/{personnelId}": {
      "schema": { "$ref": "#/entities/PersonnelProfile" },
      "description": "Shared organizational personnel directory (no raw mobile PII)."
    },
    "/personnel/{personnelId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PersonnelPrivateContact" },
      "description": "Isolated PII contact details for each personnel record."
    },
    "/workReports/{reportId}": {
      "schema": { "$ref": "#/entities/WorkReport" },
      "description": "Operational work reports and daily supervisor reports."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "Dispatched operational missions and tasks."
    },
    "/statements/{statementId}": {
      "schema": { "$ref": "#/entities/Statement" },
      "description": "Financial statements in 4-stage workflow."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/PurchaseRequest" },
      "description": "Material procurement requests."
    },
    "/priceItems/{itemId}": {
      "schema": { "$ref": "#/entities/PriceItem" },
      "description": "Approved tariff unit price items."
    },
    "/workGroups/{groupId}": {
      "schema": { "$ref": "#/entities/WorkGroup" },
      "description": "Operational work groups."
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/Contract" },
      "description": "Maintenance contracts."
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Contractor companies."
    },
    "/scoreEvents/{scoreId}": {
      "schema": { "$ref": "#/entities/ScoreEvent" },
      "description": "Technical performance score events."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Organizational audit logs."
    },
    "/stationConfigs/{stationId}": {
      "schema": { "$ref": "#/entities/StationCommState" },
      "description": "Updated substation communication channel statuses."
    },
    "/periodicTests/{testId}": {
      "schema": { "$ref": "#/entities/PeriodicTestRecord" },
      "description": "Monthly periodic test sheets across telecom, telemetry, and scada groups."
    }
  }
}
