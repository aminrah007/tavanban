{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Explicit administrator privilege document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "OrgMember": {
      "title": "OrgMember",
      "description": "Google-authenticated organizational member binding to a TavanBan operational role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "assignedRole": {
          "type": "string",
          "enum": [
            "DEPUTY",
            "EMPLOYER_MANAGER",
            "EMPLOYER_CEO",
            "EMPLOYER_EXPERT",
            "CONTRACTOR_CEO",
            "RESIDENT_REP",
            "GROUP_SUPERVISOR",
            "TECHNICIAN"
          ]
        },
        "personnelId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["uid", "email", "assignedRole", "isActive", "createdAt", "updatedAt"]
    },
    "PersonnelProfile": {
      "title": "PersonnelProfile",
      "description": "Organizational personnel directory record with role, unit/company scope, and masked contact.",
      "type": "object",
